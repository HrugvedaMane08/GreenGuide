# Copy to .env and fill in real values. Never commit .env.

# Leave unset to use the local dev database (mongodb://127.0.0.1:27017/mydb).
# Set to a full Atlas connection string to point elsewhere — an unfilled
# placeholder here will break startup, so leave it commented rather than partial.
# MONGO_URI=

# Gmail account used for crop-deadline and weather notification emails.
# GMAIL_PASS must be a 16-char Google App Password, not the account password.
GMAIL_USER=
GMAIL_PASS=

# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# https://data.gov.in — mandi price feed
DATA_GOV_API_KEY=

# https://console.groq.com — scheme explanations, translation, farmer Q&A
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Shared secret for admin-only endpoints (x-admin-key header).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# If unset, admin routes fail closed (503) rather than becoming public.
ADMIN_API_KEY=

JWT_SECRET=
JWT_EXPIRE=7d

# Rate used to show crop-plan costs in rupees (the price data is in US dollars).
# The built-in default is 83.5, which is out of date: set today's rate.
USD_TO_INR=
